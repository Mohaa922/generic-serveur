# App
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change_me_in_local_only
DEFAULT_URI=http://localhost:8086

# Ports
APP_PORT=8086
PHPMYADMIN_PORT=8081
MYSQL_PORT=3308

# MySQL credentials
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=symfony
MYSQL_USER=symfony
MYSQL_PASSWORD=symfony

# Symfony DB URL
DATABASE_URL="mysql://symfony:symfony@mysql-server:3306/symfony?serverVersion=8.0&charset=utf8mb4"


