pipeline {
    agent any

    environment {
        APP_BRANCH = 'app'
        SERVER_BRANCH = 'serveur'
    }

    stages {

        stage('Checkout infra (branche serveur)') {
            steps {
                echo "==> Checkout branche serveur"
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "*/${SERVER_BRANCH}"]],
                    userRemoteConfigs: [[
                        url: 'https://github.com/Mohaa922/generic-serveur.git'
                    ]]
                ])
            }
        }

        stage('Checkout app (branche app)') {
            steps {
                script {
                    echo "==> Suppression ancien app_src/"
                    bat 'if exist app_src rmdir /S /Q app_src'

                    echo "==> Clone branche app"
                    bat '''
                        git clone --branch app --single-branch https://github.com/Mohaa922/generic-serveur.git app_src
                    '''
                }
            }
        }

        stage('Copie du code dans www/') {
            steps {
                script {
                    echo "==> Nettoyage www/"
                    bat 'if exist www rmdir /S /Q www'

                    echo "==> Copie du contenu de app_src dans www/"
                    bat 'xcopy app_src www /E /I'
                }
            }
        }

        stage('Docker Compose up') {
            steps {
                script {
                    echo "==> Démarrage du serveur Docker"
                    bat 'docker compose down'
                    bat 'docker compose up --build -d'
                }
            }
        }
    }

    post {
        failure {
            echo "❌ Le pipeline a échoué"
        }
        success {
            echo "✅ Déploiement terminé avec succès !"
        }
    }
}
