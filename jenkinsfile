pipeline {
    agent any

    environment {
        APP_BRANCH    = 'app'
        SERVER_BRANCH = 'serveur'
        REPO_URL      = 'https://github.com/Mohaa922/generic-serveur.git'
    }

    stages {

        stage('Checkout infra (branche serveur)') {
            steps {
                echo "==> Checkout branche serveur (infra)"
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "*/${SERVER_BRANCH}"]],
                    userRemoteConfigs: [[
                        url: "${REPO_URL}"
                    ]]
                ])
            }
        }

        stage('Checkout app et préparation de www/') {
            steps {
                script {
                    echo "==> Nettoyage ancien app_src"
                    bat '''
                    cd "%WORKSPACE%"
                    if exist app_src rmdir /S /Q app_src
                    '''

                    echo "==> Clone de la branche app dans app_src/"
                    bat """
                    cd "%WORKSPACE%"
                    git clone --branch ${APP_BRANCH} --single-branch ${REPO_URL} app_src
                    """

                    echo "==> Préparation du dossier www/ pour le conteneur"
                    bat '''
                    cd "%WORKSPACE%"
                    if exist www rmdir /S /Q www
                    xcopy app_src\\www www /E /I /Y
                    '''
                }
            }
        }

        stage('Docker Compose up') {
            steps {
                script {
                    echo "==> Restart du stack Docker avec .env.compose"
                    bat '''
                    cd "%WORKSPACE%"
                    docker compose -f docker-compose.yaml --env-file .env.compose down
                    docker compose -f docker-compose.yaml --env-file .env.compose up --build -d
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "✅ Déploiement terminé avec succès !"
        }
        failure {
            echo "❌ Le pipeline a échoué"
        }
    }
}
